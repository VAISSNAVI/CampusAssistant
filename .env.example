# Authentication Secrets
JWT_SECRET=super-secure-jwt-secret-for-campus-assistant-krce
JWT_EXPIRES_IN=7d

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API for RAG
# If left blank, the assistant utilizes built-in grounded campus knowledge retrieval
GEMINI_API_KEY=

# Server & Network Configuration
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:8081

# Web/Admin app URL
VITE_API_URL=http://localhost:3000
